{
  "name": "wohkah",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:local:reset": "bash scripts/db-local-reset.sh",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:types": "supabase gen types typescript --remote=\"${DATABASE_URL:-postgresql://root@localhost/wohkah_test?host=/var/run/postgresql}\" --schema public > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.28.0",
  "description": "WOHKAH - workforce management and team collaboration SaaS. A product of Crift Concepts.",
  "engines": {
    "node": ">=22"
  }
}
