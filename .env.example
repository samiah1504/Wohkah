# WOHKAH environment variables (DRAFT, Phase 0)
# Copy to .env.local for local development. NEVER commit real values.
# Only NEXT_PUBLIC_* variables are exposed to the browser. Everything else is server-only.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ROOT_DOMAIN=localhost:3000            # wohkah.com in production; used for subdomain routing

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                # server-only; restricted module allow-list

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="WOHKAH <no-reply@wohkah.com>"

# --- Monitoring (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Background jobs (Supabase Cron + Queues), Phase 3+ ---
# Shared secret Supabase Cron sends when calling /api/jobs/worker.
# Store the same value in Supabase Vault; never put it in a migration.
JOBS_WORKER_SECRET=

# Rate limiting uses Supabase Postgres; no extra variables needed.

# --- Payments (Paystack), Phase 9 ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Custom domains (Vercel Domains API), Phase 9 ---
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
