# WOHKAH environment variables (see DEPLOYMENT.md)
# Copy to .env.local for local development. NEVER commit real values.
# Only NEXT_PUBLIC_* variables are exposed to the browser. Everything else is server-only.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ROOT_DOMAIN=localhost:3000            # wohkah.com in production; used for subdomain routing

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# New projects: publishable / secret keys. Older projects: anon / service_role. Either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=                      # server-only; bypasses RLS; restricted module allow-list
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Public contact address shown on the website (/contact). Optional.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Email (Resend). Optional: without it, invitations show a copyable link. ---
RESEND_API_KEY=
EMAIL_FROM="WOHKAH <no-reply@wohkah.com>"

# --- Monitoring (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Background jobs (Supabase Cron + Queues), Phase 3+ ---
# Shared secret Supabase Cron sends when calling /api/jobs/worker.
# Store the same value in Supabase Vault; never put it in a migration.
JOBS_WORKER_SECRET=

# Rate limiting uses Supabase Postgres; no extra variables needed.

# --- Payments (Paystack), Phase 9 ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Custom domains (Vercel Domains API), Phase 9 ---
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
